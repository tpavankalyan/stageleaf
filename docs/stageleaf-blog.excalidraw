height": 179.20000000000002, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0001", "roundness": null, "seed": 189711548, "version": 1, "versionNonce": 286867678, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "Building an event-day\nagent on Switch", "originalText": "Building an event-day\nagent on Switch", "fontSize": 80, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.12, "index": "a3"}, {"id": "el0004", "type": "text", "x": 110.0, "y": 349.20000000000005, "width": 1101.306, "height": 195.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0001", "roundness": null, "seed": 504830888, "version": 1, "versionNonce": 16399042, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "Stageleaf is a run-of-show tool for event teams. I connected it to the team's Mattermost room\nwith Switch. When something changes on the day, the agent checks the plan, proposes a fix\nin a thread, collects approvals from the people affected and publishes the new version. This\npost covers what I built, how I set up Switch on a server and what I would tell someone\nconnecting their first agent.", "originalText": "Stageleaf is a run-of-show tool for event teams. I connected it to the team's Mattermost room\nwith Switch. When something changes on the day, the agent checks the plan, proposes a fix\nin a thread, collects approvals from the people affected and publishes the new version. This\npost covers what I built, how I set up Switch on a server and what I would tell someone\nconnecting their first agent.", "