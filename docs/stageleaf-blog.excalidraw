": false, "text": "agent API", "originalText": "agent API", "fontSize": 18, "fontFamily": 5, "textAlign": "center", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b1S"}, {"id": "el0153", "type": "text", "x": 1126.296, "y": 4937.105359918122, "width": 89.408, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0095", "roundness": null, "seed": 672085193, "version": 1, "versionNonce": 670734197, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "and token", "originalText": "and token", "fontSize": 18, "fontFamily": 5, "textAlign": "center", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b1T"}, {"id": "el0154", "type": "text", "x": 114.0, "y": 5175.105359918122, "width": 246.54, "height": 75.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0095", "roundness": null, "seed": 1901860633, "version": 1, "versionNonce": 773875014, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "Where the team talks. It\ncomes with the Switch\nstack.", "originalText": "Where the team talks. It\ncomes with the Switch\nstack.", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b1U"}, {"id": "el0155", "type": "text", "x": 486.0, "y": 5175.105359918122, "width": 239.96, "height": 100.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0095", "roundness": null, "seed": 1798298462, "version": 1, "versionNonce": 1726806066, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "Bridges the channel into\na room. Agents join the\nroom through the agent\nprotocol.", "originalText": "Bridges the channel into\na room. Agents join the\nroom through the agent\nprotocol.", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b1V"}, {"id": "el0156", "type": "text", "x": 858.0, "y": 5175.105359918122, "width": 239.04, "height": 100.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0095", "roundness": null, "seed": 1729799374, "version": 1, "versionNonce": 697475006, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "Reads each message,\nasks Claude which tools\nto call and replies in the\nthread.", "originalText": "Reads each message,\nasks Claude which tools\nto call and replies in the\nthread.", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b1W"}, {"id": "el0157", "type": "text", "x": 1230.0, "y": 5175.105359918122, "width": 227.34, "height": 75.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0095", "roundness": null, "seed": 607563127, "version": 1, "versionNonce": 1563482744, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "Keeps the run of show,\nthe checks and every\npublished version.", "originalText": "Keeps the run of show,\nthe checks and every\npublished version.", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b1X"}, {"id": "frame0159", "type": "frame", "x": 0.0, "y": 5515.105359918122, "width": 1600.0, "height": 1427.5, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1576670556, "version": 1, "versionNonce": 1159453405, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "name": "03 \u00b7 Setup: the server", "index": "b1Y"}, {"id": "el0213", "type": "rectangle", "x": 0.0, "y": 5515.105359918122, "width": 1600.0, "height": 1427.5, "angle": 0, "strokeColor": "#ddd4c2", "backgroundColor": "#fffdf8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame0159", "roundness": null, "seed": 1576670556, "version": 1, "versionNonce": 1159453405, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "index": "b1Z"}, {"id": "el0160", "type": "text", "x": 110.0, "y": 5595.105359918122, "width": 234.232, "height": 27.5, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0159", "roundness": null, "seed": 1796737347, "version": 1, "versionNonce": 1334407006, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "03  Setup: the server", "originalText": "03  Setup: the server", "fontSize": 22, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b1a"}, {"id": "el0161", "type": "text", "x": 110.0, "y": 5641.105359918122, "width": 1104.95, "height": 62.099999999999994, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0159", "roundness": null, "seed": 1729545117, "version": 1, "versionNonce": 611290491, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "Switch runs from one Docker Compose file", "originalText": "Switch runs from one Docker Compose file", "fontSize": 54, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.15, "index": "b1b"}, {"id": "el0162", "type": "text", "x": 110.0, "y": 5733.205359918123, "width": 647.722, "height": 132.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0159", "roundness": null, "seed": 1121111451, "version": 1, "versionNonce": 536327784, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "Switch's quickstart uses Switch Console, a desktop app that runs\na server for you. I was working on a cloud VM without a desktop,\nso I ran the server from the standalone Compose file in the\nSwitch repository.", "originalText": "Switch's quickstart uses Switch Console, a desktop app that runs\na server for you. I was working on a cloud VM without a desktop,\nso I ran the server from the standalone Compose file in the\nSwitch repository.", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.5, "index": "b1c"}, {"id": "el0163", "type": "text", "x": 830.0, "y": 5733.205359918123, "width": 647.92, "height": 132.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0159", "roundness": null, "seed": 321294875, "version": 1, "versionNonce": 404198691, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "The Compose file has no default version, so set\nSWITCH_VERSION in .env. Read the version from the container\nregistry. The GitHub releases page lists Switch Console versions,\nwhich run ahead of the server. I used 0.31.0.", "originalText": "The Compose file has no default version, so set\nSWITCH_VERSION in .env. Read the version from the container\nregistry. The GitHub releases page lists Switch Console versions,\nwhich run ahead of the server. I used 0.31.0.", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.5, "index": "b1d"}, {"id": "el0164", "type": "rectangle", "x": 116.0, "y": 5933.205359918123, "width": 800.0, "height": 327.2, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#d9d1c0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 50, "groupIds": [], "frameId": "frame0159", "roundness": {"type": 3}, "seed": 176331095, "version": 1, "versionNonce": 1051808831, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "index": "b1e"}, {"id": "el0165", "type": "rectangle", "x": 110.0, "y": 5925.205359918123, "width": 800.0, "height": 327.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#24292f", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0159", "roundness": {"type": 3}, "seed": 788327631, "version": 1, "versionNonce": 1374553809, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "index": "b1f"}