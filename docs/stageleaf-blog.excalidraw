Elements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "no profile: always on", "originalText": "no profile: always on", "fontSize": 17, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b2I"}, {"id": "el0205", "type": "rectangle", "x": 126.1662234599159, "y": 6475.077950866621, "width": 600.0, "height": 149.60000000000002, "angle": 6.262241356155655, "strokeColor": "transparent", "backgroundColor": "#d9d1c0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 55, "groupIds": ["g4fa8a4ab10"], "frameId": "frame0159", "roundness": {"type": 3}, "seed": 1650460186, "version": 1, "versionNonce": 1229432662, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "index": "b2J"}, {"id": "el0206", "type": "rectangle", "x": 120.0, "y": 6467.205359918123, "width": 600.0, "height": 149.60000000000002, "angle": 6.262241356155655, "strokeColor": "#f2c94c", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g4fa8a4ab10"], "frameId": "frame0159", "roundness": {"type": 3}, "seed": 1566348240, "version": 1, "versionNonce": 1191520233, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "index": "b2K"}, {"id": "el0207", "type": "text", "x": 164.48, "y": 6495.205359918123, "width": 511.04, "height": 93.60000000000001, "angle": 6.262241356155655, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g4fa8a4ab10"], "frameId": "frame0159", "roundness": null, "seed": 787702073, "version": 1, "versionNonce": 806663514, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "SWITCH_VERSION has no default. Take it\nfrom the registry: the releases page lists\nConsole versions.", "originalText": "SWITCH_VERSION has no default. Take it\nfrom the registry: the releases page lists\nConsole versions.", "fontSize": 24, "fontFamily": 5, "textAlign": "center", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.3, "index": "b2L"}, {"id": "el0208", "type": "rectangle", "x": 815.8594669194401, "y": 6485.308855917998, "width": 600.0, "height": 183.4, "angle": 0.017453292519943295, "strokeColor": "transparent", "backgroundColor": "#d9d1c0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 55, "groupIds": ["g6344a862c4"], "frameId": "frame0159", "roundness": {"type": 3}, "seed": 1605617358, "version": 1, "versionNonce": 1857984951, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "index": "b2M"}, {"id": "el0209", "type": "rectangle", "x": 810.0, "y": 6477.205359918123, "width": 600.0, "height": 183.4, "angle": 0.017453292519943295, "strokeColor": "#74a8e8", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g6344a862c4"], "frameId": "frame0159", "roundness": {"type": 3}, "seed": 1252751441, "version": 1, "versionNonce": 1106200706, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "index": "b2N"}, {"id": "el0210", "type": "text", "x": 838.6478343080817, "y": 6503.370901047591, "width": 333.144, "height": 55.0, "angle": 0.017453292519943295, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g6344a862c4"], "frameId": "frame0159", "roundness": null, "seed": 587603744, "version": 1, "versionNonce": 1044157965, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "FEATURE_FLAGS_ENABLED=\nfollow_the_conversation", "originalText": "FEATURE_FLAGS_ENABLED=\nfollow_the_conversation", "fontSize": 22, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b2O"}, {"id": "el0211", "type": "text", "x": 837.4351185258242, "y": 6569.934365526975, "width": 513.512, "height": 62.400000000000006, "angle": 0.017453292519943295, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["g6344a862c4"], "frameId": "frame0159", "roundness": null, "seed": 996322704, "version": 1, "versionNonce": 226471628, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "lets a reply in the agent's thread reach the\nagent without an @-mention.", "originalText": "lets a reply in the agent's thread reach the\nagent without an @-mention.", "fontSize": 24, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.3, "index": "b2P"}, {"id": "el0212", "type": "text", "x": 110.0, "y": 6720.605359918122, "width": 1084.664, "height": 132.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0159", "roundness": null, "seed": 1432607089, "version": 1, "versionNonce": 715706989, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "The .env file holds the version, the database passwords, the agent registration token, the secret keys and the\nadmin sign-ins. The collab profile adds Mattermost and a setup container that creates a team and a first user.\nThe gateway profile adds the operator dashboard on port 3000. In the repo, npm run switch:up writes .env\nwith random secrets and starts the stack.", "originalText": "The .env file holds the version, the database passwords, the agent registration token, the secret keys and the\nadmin sign-ins. The collab profile adds Mattermost and a setup container that creates a team and a first user.\nThe gateway profile adds the operator dashboard on port 3000. In the repo, npm run switch:up writes .env\nwith random secrets and starts the stack.", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.5, "index": "b2Q"}, {"id": "frame0214", "type": "frame", "x": 0.0, "y": 7092.605359918122, "width": 1600.0, "height": 1045.8000000000002, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1335301148, "version": 1, "versionNonce": 545248387, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "name": "04 \u00b7 Setup: the agent", "index": "b2R"}, {"id": "el0253", "type": "rectangle", "x": 0.0, "y": 7092.605359918122, "width": 1600.0, "height": 1045.8000000000002, "angle": 0, "strokeColor": "#ddd4c2", "backgroundColor": "#fffdf8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame0214", "roundness": null, "seed": 1335301148, "version": 1, "versionNonce": 545248387, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "index": "b2S"}, {"id": "el0215", "type": "text", "x": 110.0, "y": 7172.605359918122, "width": 228.908, "height": 27.5, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0214", "roundness": null, "seed": 800929070, "version": 1, "versionNonce": 272643025, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "04  Setup: the agent", "originalText": "04  Setup: the agent", "fontSize": 22, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "index": "b2T"}, {"id": "el0216", "type": "text", "x": 110.0, "y": 7218.605359918122, "width": 782.138, "height": 124.19999999999999, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0214", "roundness": null, "seed": 314315870, "version": 1, "versionNonce": 993558755, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "Register the agent, open it\nto the team, create the room", "originalText": "Register the agent, open it\nto the team, create the room", "fontSize": 54, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.15, "index": "b2U"}, {"id": "el0217", "type": "text", "x": 110.0, "y": 7372.805359918122, "width": 616.9, "height": 99.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0214", "roundness": null, "seed": 1481963028, "version": 1, "versionNonce": 59759423, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "Register a custom agent with the registration token from .env.\nThe response has the agent's id and its API key. The key isn't\nshown again, so store it.", "originalText": "Register a custom agent with the registration token from .env.\nThe response has the agent's id and its API key. The key isn't\nshown again, so store it.", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.5, "index": "b2V"}, {"id": "el0218", "type": "text", "x": 830.0, "y": 7372.805359918122, "width": 644.048, "height": 132.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "frame0214", "roundness": null, "seed": 849235777, "version": 1, "versionNonce": 670137865, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "text": "A new agent answers only its owner and the owner's other\nagents. The agent can't change its own settings, but its owner or\na server admin can, through the Gateway API. Clearing the\naddressing policy lets anyone in the room address it.", "originalText": "A new agent answers only its owner and the owner's other\nagents. The agent can't change its own settings, but its owner or\na server admin can, through the Gateway API. Clearing the\naddressing policy lets anyone in the room address it.", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.5, "index": "b2W"}, {"id": "el0219", "type": "ellipse", "x": 110.0, "y": 7563.805359918122, "width": 44.0, "height": 42.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2.2, "strokeStyle": "solid", "roughness": 1.2, "opacity": 100, "groupIds": [], "frameId": "frame0214", "roundness": null, "seed": 1656742866, "version": 1, "versionNonce": 1195271558, "isDeleted": false, "boundElements": null, "updated": 1793980800000, "link": null, "locked": false, "index": "b2X"}, {"id": "el0220", "type": "text", "x": 125.449, "y": 7568.805359918122, "width": 13.102, "height": 32.5, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "tran